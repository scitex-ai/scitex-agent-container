# Dedicated test image for skill-trigger evaluation.
#
# Design (2026-04-23):
# - Based on scitex-agent-container:latest (Node + claude CLI).
# - Bakes a single synthetic skill (kv-lookup) into /home/agent/.claude/skills/.
# - Credentials are NOT baked; mount host ~/.claude/.credentials.json at runtime:
#     docker run --rm \
#       -v $HOME/.claude/.credentials.json:/home/agent/.claude/.credentials.json:ro \
#       scitex-agentic-test:latest -p "What is the value of banana?" \
#       --output-format json --model claude-haiku-4-5
# - The image itself is the isolation boundary. Nothing from the host leaks in
#   except the single credentials file.

FROM scitex-agent-container:latest

USER root

# Baked synthetic skill (kv-lookup) for Phase 1 trigger verification.
RUN mkdir -p /home/agent/.claude/skills/kv-lookup && \
    chown -R agent:agent /home/agent/.claude
COPY --chown=agent:agent skills/kv-lookup/SKILL.md /home/agent/.claude/skills/kv-lookup/SKILL.md

USER agent
WORKDIR /home/agent
ENTRYPOINT ["claude"]
