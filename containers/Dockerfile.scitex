# scitex-agent-container:scitex — :base + scitex[all] + claude-agent-sdk + sac.
#
# Default image used when an agent's spec.yaml leaves spec.image unset.
# Layered on :base so rebuilding scitex/sac doesn't re-install the OS or
# Node/Rust toolchains.
#
# Includes:
#   - ffmpeg + libffmpeg-dev + portaudio19-dev (audio/video deps for
#     scitex-audio / scitex-cv / scitex-plt video work)
#   - Python dev tooling: black, flake8, ipython, ipdb, pytest, pytest-cov
#   - claude-agent-sdk (the runner's API)
#   - scitex[all] (the umbrella; pulls numpy/pandas/scipy/torch/...)
#   - scitex-agent-container itself (sac CLI, runner module)

FROM scitex-agent-container:base

USER root

# ---- 1. Audio / video system deps -------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        portaudio19-dev \
    && rm -rf /var/lib/apt/lists/*

# ---- 2. Python tooling + scientific umbrella --------------------------
# Use a dedicated /opt/venv-sac venv so we don't fight Ubuntu 24.04's
# PEP-668 system python (Debian-installed wheels lack RECORD files,
# blocking pip --upgrade). The venv is on PATH for all downstream
# layers and the agent user.
ARG SAC_REF=develop
ENV VENV_PATH=/opt/venv-sac
RUN python3 -m venv "$VENV_PATH"
ENV PATH=$VENV_PATH/bin:$PATH

RUN pip install --no-cache-dir --upgrade \
        pip setuptools wheel \
    && pip install --no-cache-dir --upgrade \
        # python dev tooling
        black flake8 \
        ipython ipdb \
        pytest pytest-cov \
        # claude SDK (bundles its own `claude` ELF binary; no node needed)
        claude-agent-sdk \
        # scitex umbrella — full scientific stack
        "scitex[all]" \
        # sac itself, pinned by --build-arg SAC_REF
        "git+https://github.com/ywatanabe1989/scitex-agent-container.git@${SAC_REF}"

USER agent
WORKDIR /work

# tini handles signal forwarding so `docker stop <id>` cleanly triggers
# the runner's SIGTERM cooperative shutdown rather than the 10s SIGKILL.
ENTRYPOINT ["/usr/bin/tini", "--", \
            "python3", "-m", "scitex_agent_container._runners.claude_session"]
