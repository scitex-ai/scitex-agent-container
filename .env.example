# scitex-agent-container environment variables
#
# Copy this file to `.env` (gitignored) and edit values for your setup.
# Loaded automatically when the package initializes; explicit kwargs and
# CLI flags always take precedence. Variables follow the SciTeX ecosystem
# convention SCITEX_AGENT_CONTAINER_<NAME>; every var also accepts the
# short SAC_<NAME> alias (the two forms must not disagree, or sac raises
# SacEnvConflict at startup).
#
# Local state (per the SciTeX local-state convention) is read from:
#   ~/.scitex/agent-container/               user-global config + cache
#   <proj-root>/.scitex/agent-container/     project-local overrides (preferred)

# --- Credentials ---

# Sac-namespaced Anthropic auth handoff. Accepts OAuth (sk-ant-oat*) and
# API-key (sk-ant-api*) forms; the runner detects by prefix. Leave unset to
# fall back to ~/.claude/.credentials.json OAuth.
# SAC_ANTHROPIC_API_KEY=

# Telegram bot token for the per-agent Telegram bridge.
# SCITEX_AGENT_CONTAINER_TELEGRAM_BOT_TOKEN=

# --- Container identity / metadata ---

# Stable container ID (auto-assigned on first boot; override to pin).
# SCITEX_AGENT_CONTAINER_ID=

# Human-readable container name (auto by default).
# SCITEX_AGENT_CONTAINER_NAME=

# Override the container hostname (defaults to the host's).
# SCITEX_AGENT_CONTAINER_HOSTNAME=

# Role in the fleet, e.g. worker / observer (default: worker).
# SCITEX_AGENT_CONTAINER_ROLE=

# Agent engine: claude / codex / ... (default: claude).
# SCITEX_AGENT_CONTAINER_AGENT=

# Path to the agent-metadata generator script (bundled by default).
# SCITEX_AGENT_CONTAINER_AGENT_META_SCRIPT=

# LLM model ID injected into the agent.
# SCITEX_AGENT_CONTAINER_MODEL=

# Metadata schema version (current by default).
# SCITEX_AGENT_CONTAINER_META_VERSION=

# GNU-screen session name attached to the agent (auto by default).
# SCITEX_AGENT_CONTAINER_SCREEN_NAME=

# --- Paths ---

# Path to the YAML config file (bundled by default).
# SCITEX_AGENT_CONTAINER_CONFIG_PATH=

# host_config.yaml home (~/.scitex/agent-container by default).
# SCITEX_AGENT_CONTAINER_HOME=

# Extra dirs scanned for YAML overrides (colon-separated).
# SCITEX_AGENT_CONTAINER_YAML_DIRS=

# Directory where the container registers its presence
# (default: ~/.scitex/agent-container/runtime/registry).
# SCITEX_AGENT_CONTAINER_REGISTRY_DIR=

# Per-agent runtime state root: pid / heartbeat.json / session.jsonl
# (default: ~/.scitex/agent-container/runtime).
# SCITEX_AGENT_CONTAINER_RUNTIME_DIR=

# Override the sac state database path (default lives under runtime/).
# SCITEX_AGENT_CONTAINER_STATE_DB=

# Agent-local cache directory (default: ~/.cache/scitex-agent).
# SAC_CACHE_DIR=

# Directory for SLURM-job state handoff
# (default: ~/.scitex/agent-container/slurm).
# SCITEX_AGENT_CONTAINER_SLURM_STATE_DIR=

# --- Fleet hub (optional; standalone when unset) ---

# Fleet hub endpoint. Unset = standalone agent.
# SCITEX_AGENT_CONTAINER_HUB_URL=

# Bearer token for the fleet hub.
# SCITEX_AGENT_CONTAINER_HUB_TOKEN=

# --- Email relay (operator notifications; drives the OAuth login-relay) ---
#
# When an agent's TUI hits the Claude login wall, sac auto-runs `/login`,
# scrapes the OAuth URL, and emails it to the operator (who logs in and
# relays the code back via `sac send <agent> <code>`). The send is owned by
# sac (config below) and delegated to scitex_notification.send_email.

# Recipient of operator emails (the OAuth URL etc.). REQUIRED — no default;
# email cannot fire until this is set to your address.
# SCITEX_AGENT_CONTAINER_EMAIL_TO=

# Sender identity (default: agent@scitex.ai).
# SCITEX_AGENT_CONTAINER_EMAIL_FROM=agent@scitex.ai

# SMTP password for the sender. SECRET — set this in your shell secrets
# layer (01_agent-container.src), never in a committed config.yaml.
# SCITEX_AGENT_CONTAINER_EMAIL_PASSWORD=

# SMTP coordinates for the sender (defaults: mail1030.onamae.ne.jp / 587).
# Note the host default is the agent@scitex.ai provider, NOT gmail — an
# agent@scitex.ai login against smtp.gmail.com would be rejected.
# SCITEX_AGENT_CONTAINER_EMAIL_SMTP_HOST=mail1030.onamae.ne.jp
# SCITEX_AGENT_CONTAINER_EMAIL_SMTP_PORT=587

# Master enable switch for the email relay (default: true — on for agents).
# SCITEX_AGENT_CONTAINER_EMAIL_ENABLED=true
