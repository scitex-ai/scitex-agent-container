{
  "_comment_telegram_format_hooks": "Only the no-bare-reference hook includes native literal input rails; it delegates to matched package-owned CCT. Other format matchers retain their existing scope.",
  "PreToolUse": [
    {
      "matcher": "mcp__claude-code-telegrammer__reply",
      "hooks": [
        {
          "type": "command",
          "command": "$HOME/.claude/hooks/pre-tool-use/enforce_telegram_numbering.sh"
        },
        {
          "type": "command",
          "command": "$HOME/.claude/hooks/pre-tool-use/enforce_telegram_use_lists.sh"
        },
        {
          "type": "command",
          "command": "$HOME/.claude/hooks/pre-tool-use/enforce_telegram_no_filler.sh"
        },
        {
          "type": "command",
          "command": "$HOME/.claude/hooks/pre-tool-use/encourage_telegram_terse_style.sh"
        }
      ]
    },
    {
      "matcher": "^(?:mcp__claude-code-telegrammer__(?:reply|edit_message|send_document)|mcp__claude_code_telegrammer__(?:reply|edit_message|send_document)|functions\\.exec|functions\\.exec_command|exec_command|Bash)$",
      "hooks": [
        {
          "type": "command",
          "command": "$HOME/.claude/hooks/pre-tool-use/enforce_telegram_no_bare_issue.sh"
        }
      ]
    }
  ]
}
