diff --git a/hermes_cli/runtime_provider_pool.py b/hermes_cli/runtime_provider_pool.py
new file mode 100644
index 000000000..4b668a4a3
--- /dev/null
+++ b/hermes_cli/runtime_provider_pool.py
@@ -0,0 +1,25 @@
+"""Exhausted credential pools must not fall through to unpooled credentials."""
+
+from datetime import datetime, timezone
+import time
+
+from hermes_cli.auth import AuthError
+from hermes_cli.auth_constants import CREDENTIAL_POOL_QUOTA_EXHAUSTED_CODE
+
+
+def exhausted_pool_error(pool, *, model=None):
+    """Name the failed pool and its earliest reset without exposing credentials."""
+    until = pool.next_available_at(model=model)
+    reset = (
+        datetime.fromtimestamp(until, timezone.utc).isoformat()
+        if until is not None else "unknown; inspect the credential pool"
+    )
+    quota = any(entry.last_error_code in (402, 429) for entry in pool.entries())
+    return AuthError(
+        f"All credentials exhausted for {pool.provider}; next reset: {reset}. "
+        "Use a configured fallback provider or wait for the reset.",
+        provider=pool.provider,
+        code=CREDENTIAL_POOL_QUOTA_EXHAUSTED_CODE if quota else "credential_pool_exhausted",
+        retryable=False,
+        retry_after=max(0, until - time.time()) if until is not None else None,
+    )
