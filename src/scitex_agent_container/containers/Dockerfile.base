# scitex-agent-container:base — OS + developer tooling, no scitex.
#
# This is the lowest layer. Everything an agent might want before it
# starts pip-installing project deps:
#
#   - Build prerequisites (build-essential + headers for native wheels)
#   - VCS + GitHub: git, gh, openssh-client, autossh, sshpass, git-crypt
#   - Network basics: curl, wget, ca-certificates, dnsutils, netcat
#   - Python toolchain: python3, pipx, uv (Astral)
#   - Node toolchain: node, npm, with global formatter/linter set
#     (prettier, eslint, jsonlint(zaach), @mermaid-js/mermaid-cli)
#   - Rust toolchain + modern CLIs: fd, bat, eza, ripgrep, rtk
#   - tree v2.1.3 from source
#
# What's NOT here (lives in :scitex):
#   - scitex itself + Python scientific stack (scitex[all])
#   - claude-agent-sdk
#   - ffmpeg (needed by scitex-audio / scitex-cv)
#   - black / flake8 / pytest (Python tooling tied to scitex's policy)
#
# Mirrors ~/.bin/installers/ + scitex-template/templates/singularity/modules/.
# Multi-stage build keeps cargo / npm caches out of the final layer.

FROM ubuntu:24.04 AS base-system

ARG DEBIAN_FRONTEND=noninteractive

# ---- 1. apt: system packages -------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        # network basics
        ca-certificates curl wget gnupg \
        # source control
        git openssh-client sshpass autossh git-crypt \
        # build prerequisites
        build-essential pkg-config \
        libffi-dev libssl-dev libgl1-mesa-dev libc6-dev \
        # python toolchain
        python3 python3-pip python3-venv python3-dev \
        # i18n / time
        locales tzdata \
        # process tools
        htop procps lsof strace less \
        # net debugging
        iputils-ping dnsutils netcat-openbsd \
        # editors / parsing
        nano jq \
        # signal handling for pid 1
        tini \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# ---- 2. GitHub CLI -----------------------------------------------------
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# ---- 3. Node.js + npm globals -----------------------------------------
# NodeSource for an up-to-date node (Ubuntu's apt is usually multiple LTS behind).
ENV NPM_GLOBAL=/opt/npm-global \
    PATH=/opt/npm-global/bin:$PATH
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p $NPM_GLOBAL \
    && npm config set prefix $NPM_GLOBAL \
    && npm install -g \
        prettier \
        eslint \
        @typescript-eslint/parser \
        @typescript-eslint/eslint-plugin \
        jsonlint \
        @mermaid-js/mermaid-cli \
    && npx puppeteer browsers install chrome-headless-shell

# ---- 4. Rust toolchain + Rust CLIs ------------------------------------
# Rust toolchain is needed for `cargo binstall` (prebuilt fetch) and as a
# fallback for any tool whose binstall manifest is broken upstream.
ENV RUSTUP_HOME=/opt/rust \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --no-modify-path \
    && curl --proto '=https' --tlsv1.2 -sSfL \
        https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh \
        | bash \
    && cargo binstall --no-confirm --force \
        fd-find \
        bat \
        eza \
        ripgrep \
    && rm -rf /opt/cargo/registry /opt/cargo/git

# ---- 5. tree v2.1.3 from source ----------------------------------------
RUN curl -fsSL https://gitlab.com/OldManProgrammer/unix-tree/-/archive/2.1.3/unix-tree-2.1.3.tar.gz \
        | tar xz -C /tmp \
    && make -C /tmp/unix-tree-2.1.3 -j"$(nproc)" \
    && make -C /tmp/unix-tree-2.1.3 install PREFIX=/usr/local \
    && rm -rf /tmp/unix-tree-*

# ---- 6. uv (Astral) + pipx --------------------------------------------
ENV UV_INSTALL_DIR=/usr/local/bin
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && python3 -m pip install --no-cache-dir --break-system-packages pipx \
    && pipx ensurepath

# ---- 7. RTK (deferred) -------------------------------------------------
# RTK (Rust Token Killer) is currently a host-only tool (~/proj/rtk is
# not yet a public GitHub repo). Once published it can be added to a
# future :dev layer; for now agents call it via the host bind-mount
# when needed.

# ---- 8. Non-root user --------------------------------------------------
# Ubuntu 24.04 ships a default `ubuntu` user at UID 1000; remove it first
# so the canonical sac user owns 1000:1000.
RUN userdel -r ubuntu 2>/dev/null || true \
    && useradd -m -u 1000 -s /bin/bash agent \
    && mkdir -p /home/agent/.claude \
    && chown -R agent:agent /home/agent

USER agent
WORKDIR /home/agent
