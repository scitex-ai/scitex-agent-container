# scitex-agent-container:base — Apptainer recipe (canonical SSoT).
#
# Self-contained: no `source`-ing of external module trees. The matching
# Dockerfile.base is a hand-mirrored convenience for dev-laptop docker
# users; this .def is the canonical record of what `:base` contains.
#
# Build (preferred — go through scitex-container for versioning/sandbox):
#   scitex-container build scitex-agent-container-base
#
# Build (raw apptainer):
#   apptainer build scitex-agent-container-base.sif containers/apptainer-base.def
#   apptainer build --sandbox base/ containers/apptainer-base.def
#
# Sandbox + mutate:
#   apptainer build --sandbox base/ apptainer-base.def
#   apptainer exec --writable base/ apt-get install -y NEW_TOOL
#   apptainer build base.sif base/        # re-bake to immutable
#
# Layer this with apptainer-scitex.def to add scitex[all] + claude-sdk + sac.

Bootstrap: docker
From: ubuntu:24.04

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    # ---- 1. apt: system packages ---------------------------------------
    # Dev-CLIs ship from apt where Ubuntu 24.04 carries them — faster
    # builds, no rust toolchain dependency for the default set. The
    # Debian binary-name quirk (fd→fdfind, bat→batcat) is resolved by
    # symlinks in section 1b. ``tree`` is still source-built in section
    # 5 (apt ships an older 2.0.x; we want 2.1.3 features).
    #
    # Agent-useful, non-interactive CLI tool set:
    #   fd-find ripgrep bat eza tree jq git-delta gdu (apt)
    #   yq sd dust (sections 4a / 4b — not in apt)
    # Interactive-only tools (htop, top, ncdu, fzf TUI mode) are
    # intentionally excluded — sac agents are headless; an agent has
    # no TTY to drive a curses UI and `htop` is dead weight in the SIF.
    # `procps`/`lsof`/`strace`/`less` stay because their NON-interactive
    # modes (pgrep, ps, lsof piped, strace -c, less -F) are agent-useful.
    #
    # git/curl/ca-certificates/openssh-client are listed here so any
    # future base-image trim cannot silently drop them — sac runtime
    # hard-depends on each one (HTTPS verify chain, SSH dispatch, git).
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl wget gnupg \
        git openssh-client sshpass autossh git-crypt \
        build-essential pkg-config \
        libffi-dev libssl-dev libgl1-mesa-dev libc6-dev \
        python3 python3-pip python3-venv python3-dev \
        locales tzdata \
        procps lsof strace less \
        iputils-ping dnsutils netcat-openbsd \
        nano jq \
        fd-find ripgrep bat eza \
        git-delta gdu \
        tini
    locale-gen en_US.UTF-8

    # ---- 1a. Canonical container user `agent` (UID 1000) --------------
    # Ubuntu 24.04's base image ships a `ubuntu` user at UID 1000. sac's
    # convention (D5 in docs/isolation.md) is that the in-container user
    # is always `agent` with HOME=/home/agent — operator-independent,
    # matches sac's auto-injected `--home /home/agent`, and gives
    # `whoami` a meaningful answer (the host operator's UID still maps
    # to UID 1000 inside via apptainer's passwd inheritance, but the
    # entry at UID 1000 is now `agent`, not `ubuntu`).
    userdel -r ubuntu 2>/dev/null || true
    rm -rf /home/ubuntu
    useradd -m -d /home/agent -s /bin/bash -u 1000 agent

    # ---- 1b. Debian binary-name quirk symlinks -------------------------
    # apt-installed ``fd-find`` ships its binary as ``fdfind`` (avoids a
    # name clash with the long-retired ``fd`` chess engine package), and
    # ``bat`` ships as ``batcat`` (clash with bacula-console-tray). Every
    # piece of muscle memory + tooling we care about (rg/fd shorthand,
    # ``bat`` pager) expects the short names; symlink both into
    # ``/usr/local/bin`` so the apt build behaves like an upstream
    # cargo-installed name. ``ripgrep`` and ``eza`` already install as
    # ``rg`` / ``eza`` — no symlink needed.
    ln -sf "$(command -v fdfind)" /usr/local/bin/fd
    ln -sf "$(command -v batcat)" /usr/local/bin/bat

    # ---- 2. GitHub CLI -------------------------------------------------
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list
    apt-get update
    apt-get install -y --no-install-recommends gh

    # ---- 3. Node.js + npm globals --------------------------------------
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get install -y --no-install-recommends nodejs
    mkdir -p /opt/npm-global
    npm config set prefix /opt/npm-global
    export PATH=/opt/npm-global/bin:$PATH
    npm install -g \
        prettier \
        eslint \
        @typescript-eslint/parser \
        @typescript-eslint/eslint-plugin \
        jsonlint \
        @mermaid-js/mermaid-cli

    # ---- 3a. Claude Code CLI — bundled with claude-agent-sdk -------
    # No separate install needed: pip install claude-agent-sdk bundles
    # the matching CLI binary under _bundled/claude (see
    # claude-agent-sdk-python README). We symlink it onto PATH in
    # section 6b after the venv is built.
    npx puppeteer browsers install chrome-headless-shell || true

    rm -rf /var/lib/apt/lists/*

    # ---- 4. Rust toolchain + cargo-binstall ----------------------------
    # Toolchain + cargo-binstall stay so additional Rust CLIs can be
    # layered in (apptainer-scitex.def or downstream image-rebuild flows)
    # without re-installing rustup. The default dev-CLI set baked here:
    #
    #   * ``sd``   — sed-like find/replace, non-interactive (Rust)
    #   * ``dust`` — du-like disk-usage summary (one-shot, non-interactive)
    #
    # Both are useful to a headless agent (scripted refactors, "what is
    # eating my overlay") and ship from cargo because Ubuntu 24.04 has
    # neither in apt. The interactive disk-explorer cousins
    # (``ncdu``, ``gdu`` TUI mode) are deliberately NOT installed —
    # ``gdu --non-interactive`` from apt covers the headless case in
    # section 1.
    #
    # For the operator's hand-curated extra Rust-CLI set (per-host,
    # post-launch in an overlay) see ``~/.bin/installers/install_rust_clis.sh``
    # in the operator dotfiles.
    export RUSTUP_HOME=/opt/rust
    export CARGO_HOME=/opt/cargo
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --no-modify-path
    export PATH=/opt/cargo/bin:$PATH
    curl --proto '=https' --tlsv1.2 -sSfL \
        https://github.com/cargo-bins/cargo-binstall/releases/latest/download/cargo-binstall-x86_64-unknown-linux-musl.tgz \
        | tar xz -C /opt/cargo/bin/
    chmod +x /opt/cargo/bin/cargo-binstall
    cargo binstall --no-confirm --force sd du-dust
    rm -rf /opt/cargo/registry /opt/cargo/git

    # ---- 4a. yq — pulled as a static binary from mikefarah/yq --------
    # ``yq`` is the YAML cousin of ``jq``; Ubuntu's ``yq`` apt package
    # ships kislyuk/yq (a thin jq wrapper, different CLI surface), not
    # the mikefarah Go binary that the rest of the SciTeX ecosystem
    # uses. Pull the Go binary directly to /usr/local/bin so callers
    # get the expected `.path | select(...)` syntax — non-interactive,
    # single static binary, no runtime deps.
    curl -fsSL \
        https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 \
        -o /usr/local/bin/yq
    chmod +x /usr/local/bin/yq

    # ---- 5. tree v2.1.3 from source ------------------------------------
    curl -fsSL https://gitlab.com/OldManProgrammer/unix-tree/-/archive/2.1.3/unix-tree-2.1.3.tar.gz \
        | tar xz -C /tmp
    make -C /tmp/unix-tree-2.1.3 -j"$(nproc)"
    make -C /tmp/unix-tree-2.1.3 install PREFIX=/usr/local
    rm -rf /tmp/unix-tree-*

    # ---- 6. uv (Astral) + pipx -----------------------------------------
    UV_INSTALL_DIR=/usr/local/bin curl -LsSf https://astral.sh/uv/install.sh | sh
    python3 -m pip install --no-cache-dir --break-system-packages pipx

    # ---- 6a. python convenience symlink -----------------------------
    # Ubuntu 24.04's `python3-is-python3` doesn't ship by default; many
    # tools (and sac's runner shim) call bare `python`. One symlink
    # makes the SIF compatible with both without forcing every caller
    # to use `python3`.
    ln -sf /usr/bin/python3 /usr/local/bin/python

    # ---- 6b. SAC runner deps (minimal, no scitex umbrella) ----------
    # The runner module that sac's apptainer dispatcher invokes lives
    # in scitex-agent-container, which needs claude-agent-sdk. Install
    # just these two into a dedicated venv so /usr/bin/python3 stays
    # untouched and per-agent overlays own their own scientific stack.
    #
    # claude-agent-sdk PINNED to 0.1.72 — newer 0.1.81 bundles claude
    # CLI 2.1.139, which has a regression that hangs on the startup
    # `GET /v1/mcp_servers` call inside apptainer (proven against the
    # host's working 0.1.72/2.1.112 pair, same SIF, same creds,
    # same network — only the bundled binary differs). The SDK
    # bundles its CLI under `_bundled/claude`, so pinning the Python
    # version also pins the binary — no separate `claude` install
    # needed (see Anthropic's claude-agent-sdk-python README). 2026-05-12.
    #
    # uv landed at /root/.local/bin/uv (the uv installer ignores
    # UV_INSTALL_DIR for the curl|sh path and uses XDG_BIN_HOME ->
    # ~/.local/bin under root). PATH below is conservative — extend
    # it explicitly rather than rely on the build shell.
    python3 -m venv /opt/venv-sac
    export PATH=/root/.local/bin:/usr/local/bin:$PATH
    uv pip install --python /opt/venv-sac/bin/python \
        "claude-agent-sdk==0.1.72" \
        "git+https://github.com/ywatanabe1989/scitex-agent-container.git@main"

    # Surface the SDK's bundled claude CLI on PATH so humans can
    # `apptainer shell` and run `claude` interactively, and so that
    # subprocess_cli's bundled-fallback path resolves the same binary
    # the SDK uses programmatically.
    if [ -x /opt/venv-sac/lib/python3.12/site-packages/claude_agent_sdk/_bundled/claude ]; then
        ln -sf /opt/venv-sac/lib/python3.12/site-packages/claude_agent_sdk/_bundled/claude \
            /usr/local/bin/claude
    fi

    # ---- 7. RTK (deferred — repo not yet public) -----------------------

%environment
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
    # /opt/venv-sac/bin first so the runner uses the SAC-shipped python
    # (with scitex-agent-container + claude-agent-sdk preinstalled).
    # /root/.local/bin holds the install.sh-installed `claude` binary
    # (preferred over npm package — see %post note).
    export PATH=/opt/venv-sac/bin:/root/.local/bin:/opt/cargo/bin:/opt/npm-global/bin:/usr/local/bin:$PATH
    export RUSTUP_HOME=/opt/rust
    export CARGO_HOME=/opt/cargo

%labels
    org.scitex.layer base
    org.scitex.runtime apptainer
    org.scitex.contains "git gh node npm rustc cargo fd bat eza rg tree jq yq delta gdu sd dust uv pipx mermaid prettier eslint jsonlint"

%help
    scitex-agent-container :base layer.
    OS + developer tooling. Layer apptainer-scitex.def on top to add
    scitex[all] + claude-agent-sdk + sac itself.
