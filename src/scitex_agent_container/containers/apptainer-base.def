# scitex-agent-container:base — Apptainer recipe (canonical SSoT).
#
# LAYER 3 of 4, and the CAPSTONE of the agent runtime stack. As of the
# four-layer split this recipe is deliberately THIN: everything :base
# used to install directly now lives in the two layers below it, and
# what remains here is the composition step — bake the `sac versions`
# manifest that describes the assembled venv, and publish the :base
# environment/labels contract every downstream consumer reads.
#
# :base IS STILL THE FLEET'S BOOT IMAGE. Most agent specs boot
# sac-base.sif directly; splitting the recipe changed WHERE things are
# installed, not what a :base container contains. A :base SIF carries
# the union of layers 1-3.
#
# The four-layer stack:
#   1. system-deps      OS + toolchain    (from ubuntu@sha256:...)
#   2. python-pkgs      venv + SAC deps   (from ./sac-system-deps.sif)
#   3. base             <- YOU ARE HERE   (from ./sac-python-pkgs.sif)
#   4. scitex           scitex[all]       (from ./sac-base.sif)
#
# Build (preferred — go through sac so staging/versioning/atomic swap apply):
#   sac image build base -y             # requires sac-python-pkgs.sif
#
# Build the whole stack from nothing:
#   sac image build system-deps -y
#   sac image build python-pkgs -y
#   sac image build base -y
#
# Sandbox + mutate:
#   apptainer build --sandbox base/ apptainer-base.def
#   apptainer exec --writable base/ apt-get install -y NEW_TOOL
#   apptainer build base.sif base/        # re-bake to immutable
#
# Layer this with apptainer-scitex.def to add scitex[all] on top.

Bootstrap: localimage
# The prerequisite SIF, resolved RELATIVE to the build-context directory.
# ``sac image build`` stages a context dir containing this .def alongside a
# symlink to <containers>/sac-python-pkgs/sac-python-pkgs.sif and sets the
# build CWD there, so this relative path resolves. Building raw with
# ``apptainer build`` requires you to arrange the same adjacency yourself.
From: ./sac-python-pkgs.sif

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    # ---- 8. Bake the scitex-* version manifest (`sac versions`) --------
    # `sac versions --json` reads this baked manifest (source="manifest",
    # near-zero cost — a `cat`, not a full `pip list`) so scitex-dev's
    # ecosystem drift aggregator can see the base-image venv layer cheaply.
    # The verb falls back to a live `apptainer exec <sif> pip list` when
    # this file is absent (older images not yet rebuilt), so shipping it is
    # purely additive. Filtered to the scitex-* ecosystem packages; written
    # in pip's own `--format=json` shape so the reader parses both paths
    # identically. Pure pipe + `python -c` (dash-safe — apptainer %post runs
    # under /bin/sh, which has no bash process substitution).
    #
    # THIS RUNS AT :base, THE TOP OF THE PYTHON STACK, ON PURPOSE. The venv
    # is assembled by :python-pkgs; the manifest must describe the venv as
    # it will actually SHIP, so it is captured by the last layer that can
    # still see a final answer. Capturing it one layer down would freeze a
    # snapshot taken before this layer existed.
    /opt/venv-sac/bin/pip list --format=json \
        | /opt/venv-sac/bin/python -c 'import json,sys; rows=[r for r in json.load(sys.stdin) if str(r.get("name","")).lower().replace("_","-").split("-")[0]=="scitex"]; json.dump(sorted(rows,key=lambda r:str(r.get("name","")).lower()), sys.stdout, indent=2)' \
        > /opt/scitex-versions.json
    cat /opt/scitex-versions.json

%environment
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
    # /opt/venv-sac/bin first so the runner uses the SAC-shipped python
    # (with scitex-agent-container + claude-agent-sdk preinstalled).
    # The PATH `claude` resolves to /usr/local/bin/claude, which the
    # :python-pkgs layer symlinks at the standalone npm
    # `@anthropic-ai/claude-code@latest` binary (/opt/npm-global/bin/claude)
    # — DECOUPLED from the SDK's OWN bundled CLI (for `fable[1m]`). No
    # `claude` lands in /opt/venv-sac/bin or /root/.local/bin (the latter
    # holds only uv), so those earlier entries do NOT shadow the npm
    # claude symlink.
    #
    # Declared in FULL, not as a delta: apptainer OVERWRITES
    # /.singularity.d/env/90-environment.sh on each localimage-derived
    # build, so a child that exports only its own additions silently
    # drops the parent's PATH ordering.
    export PATH=/opt/venv-sac/bin:/root/.local/bin:/opt/cargo/bin:/opt/npm-global/bin:/usr/local/bin:$PATH
    export RUSTUP_HOME=/opt/rust
    export CARGO_HOME=/opt/cargo

%labels
    org.scitex.layer base
    org.scitex.runtime apptainer
    org.scitex.from scitex-agent-container:python-pkgs
    org.scitex.contains "git gh node npm rustc cargo fd bat eza rg tree jq yq delta gdu sd dust uv pipx pre-commit mermaid prettier eslint jsonlint apptainer rtk claude-agent-sdk scitex-cards scitex-agent-container[all,dev]"

%help
    scitex-agent-container :base layer (stack layer 3 of 4).
    OS + developer tooling (from :system-deps) plus the SAC python venv
    (from :python-pkgs), capped with the baked `sac versions` manifest.
    This is the fleet's default boot image. Layer apptainer-scitex.def
    on top to add scitex[all].
