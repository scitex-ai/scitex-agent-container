# scitex-agent-container:scitex — Apptainer recipe (canonical SSoT).
#
# Layered on apptainer-base. Default image used when an agent's
# spec.yaml leaves spec.image unset.
#
# Adds:
#   - python venv at /opt/venv-sac/ (avoids Ubuntu's PEP-668 fight)
#   - black, flake8, ipython, ipdb, pytest, pytest-cov
#   - claude-agent-sdk (the runner's API; bundles its own claude binary)
#   - scitex[all] (scientific stack)
#   - scitex-dev + scitex-writer/-audio/-cv (pinned PyPI; system-deps providers)
#   - the federated system (apt) deps declared by those leaves via the
#     ``scitex_dev.system_deps`` entry-point group (SSoT — NOT a hardcoded
#     apt list): ffmpeg/portaudio (audio) and the curated manuscript LaTeX
#     toolchain (latex/latexmk/biber). scitex-cv (opencv-python-headless)
#     declares zero apt deps.
#   - scitex-agent-container (sac CLI + runner module)
#
# Build:
#   # 1. base layer first
#   apptainer build base.sif containers/apptainer-base.def
#   # 2. then scitex on top, using base.sif as the bootstrap source
#   apptainer build scitex.sif containers/apptainer-scitex.def
#
# Or via scitex-container (preferred, with versioning):
#   scitex-container build scitex-agent-container-scitex

Bootstrap: localimage
From: ./sac-base.sif

%files
    # Bundle the package's OWN source tree on top of the base layer so
    # this layer's sac install is the source tree that shipped this
    # .def — see apptainer-base.def for the staging contract. Both
    # layers land the same tree at /opt/scitex-agent-container-src so a
    # version mismatch between base and scitex is structurally
    # impossible (both came from the same `sac image build` invocation).
    scitex-agent-container-src /opt/scitex-agent-container-src

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    # ---- 1. System (apt) deps now come from the federated SSoT ----------
    # The audio/video + LaTeX apt packages that USED to be hardcoded here
    # are now DECLARED by the leaf packages themselves via the
    # ``scitex_dev.system_deps`` entry-point group, aggregated by the
    # scitex-dev keystone and installed in section 3 below (after the venv
    # is built so the providers' entry-points are discoverable). Root-cause
    # SSoT: each leaf owns its own apt deps; no hardcoded apt list here.
    #   - ffmpeg / portaudio19-dev          → scitex-audio._system_deps
    #   - scitex-cv declares ZERO apt deps — opencv-python-headless bundles
    #       cv2's native libs in the wheel, so its provider returns [] (the
    #       old libxcb1/libgl1/libglib2.0-0 X-libs are no longer needed).
    #   - the curated texlive / biber / latexmk set → scitex-writer._system_deps
    # A FAIL-LOUD SUPERSET GUARD in section 3 verifies the federated set
    # still covers every package these blocks used to install, so this
    # cutover cannot silently drop a dependency.

    # ---- 2. Python venv + scitex stack ---------------------------------
    # Dedicated venv avoids Ubuntu 24.04 PEP-668 collisions with apt-installed
    # python3-wheel etc. PATH below puts /opt/venv-sac/bin first so all
    # python work hits this venv automatically.
    #
    # Resolver: uv (Rust, parallel) instead of pip. ``scitex[all]`` has a
    # huge transitive set (openalex-local, sphinx-rtd-theme, etc.) that
    # makes pip's backtracking thrash for 30+ min downloading metadata.
    # uv solves the same dependency set in 1-3 min by resolving in
    # parallel.  Falls back to pip if uv is missing on the base layer.
    python3 -m venv /opt/venv-sac
    # Ensure uv is reachable: the apptainer-base layer installs it to
    # /root/.local/bin (uv installer ignores UV_INSTALL_DIR for the
    # curl|sh path and uses XDG_BIN_HOME → ~/.local/bin under root).
    # apptainer's %post starts with a minimal PATH so we extend it.
    export PATH="/root/.local/bin:/usr/local/bin:$PATH"
    # sac is installed from /opt/scitex-agent-container-src/ — the
    # package's OWN source tree, copied in by the %files section above.
    # The SIF's sac version is structurally pinned to the source tree
    # that shipped this .def; no `git+...@main` snapshot drift.
    # claude-agent-sdk MUST be pinned here too — leaving it unpinned
    # lets uv/pip drift away from the base layer's 0.2.87 pin (the
    # version that bundles the working claude CLI 2.1.150). Keep
    # both branches' version in lockstep with apptainer-base.def.
    #
    # ``xarray`` is listed EXPLICITLY here because ``scitex[all]``'s
    # current extras set does not pull it. Without xarray, clew's
    # ``scitex.io`` preflight on Spartan fails its import probe and
    # silently falls back to "minimal mode" — runs look green but
    # lose the labelled-array surface the cohort-A capsules need.
    # Pinned explicit so a future ``scitex[all]`` re-bake cannot
    # silently drop the dep without surfacing as a build-time
    # uv/pip failure. (Caught by clew's capsule-0220918 audit,
    # 2026-06-06; symmetric with the apt-side libglib2.0-0 add in
    # apptainer-base.def — both close silent-fallback paths.)
    # Two-pass install — single-pass shipped pre-#41 (0.21.9) sac for
    # every scitex-layer rebuild after the scitex PyPI cut.
    #
    # Why: ``scitex[all]`` has a transitive
    # ``scitex-agent-container==0.21.9; extra == "all"`` (verified
    # against PyPI metadata 2026-06-07). Resolved alongside the
    # bundled local source ``/opt/scitex-agent-container-src`` in ONE
    # ``uv pip install``, uv installs the PyPI 0.21.9 wheel for the
    # transitive constraint, then sees the local source resolves to
    # the SAME version (0.21.9; develop hasn't bumped) and SKIPS the
    # re-install under its "version-already-satisfied" check. The SIF
    # quietly ships pre-#41 sac despite the .def staging the .def-time
    # source tree. Lead a2a ``f3f9bfa0`` + ``ce08f1d0`` (2026-06-07)
    # caught this on the #41 deploy attempt — the rebuilt SIF didn't
    # carry ``WakeableInbox`` even though the git pin was on develop HEAD.
    #
    # Fix: split into two install invocations.
    #   step 1: scitex[all] + everything else (resolves the transitive
    #     scitex-agent-container==0.21.9 from PyPI; that wheel is OK to
    #     install — it'll get overwritten in step 2).
    #   step 2: ``--force-reinstall --no-deps /opt/scitex-agent-container-src``
    #     — force-reinstall because uv/pip's version-already-satisfied
    #     check would otherwise skip; --no-deps because step 1 already
    #     resolved every transitive, re-resolving here would thrash for
    #     no gain.
    #
    # ``--reinstall-package scitex-agent-container`` is the uv-specific
    # shorthand (narrower blast radius) and would also work; we use the
    # portable ``--force-reinstall --no-deps`` form so the pip-fallback
    # branch below uses the same flags.
    if command -v uv >/dev/null; then
        uv pip install --python /opt/venv-sac/bin/python \
            black flake8 \
            ipython ipdb \
            pytest pytest-cov \
            "claude-agent-sdk==0.2.110" \
            "scitex[all]" \
            xarray
        uv pip install --python /opt/venv-sac/bin/python \
            --force-reinstall --no-deps \
            /opt/scitex-agent-container-src
        # scitex-dev keystone (system-deps aggregator) + the 3 leaf providers,
        # pinned to PUBLISHED PyPI floors (reproducible — NOT a moving git
        # branch ref; the operator's hard requirement). scitex[all] pulls
        # older transitive pins (e.g. a scitex-dev without the system_deps
        # module); these explicit floors OVERRIDE them so ``scitex-dev
        # ecosystem system-deps`` exists and every leaf's
        # ``scitex_dev.system_deps`` entry-point is discoverable for the
        # federated install in section 3.
        #   scitex-dev   >=0.20.1 — keystone aggregator (list/install/check-superset)
        #   scitex-writer>=2.22.0 — texlive provider (ships the soul.sty fix)
        #   scitex-audio >=0.3.0  — ffmpeg/portaudio provider
        #   scitex-cv    >=0.2.0  — opencv-python-headless; provider declares []
        # scitex-todo >=0.7.32 (TEMP downgrade from 0.7.38: 0.7.38 is NOT yet on
        # PyPI — max published is 0.7.32 — so a >=0.7.38 floor makes the build
        # UNSATISFIABLE (uv/pip resolve exit-255). Path B (the `scitex serve`
        # aggregator) mounts scitex-todo IN-PROCESS and drops the standalone
        # `scitex-todo mcp start` server, so the #338 wedge cannot occur under
        # the aggregator → 0.7.32 is safe. Restore >=0.7.38 when it publishes.)
        # Historical 0.7.38 rationale (NOT a
        # system-deps provider): 0.7.38 carries #338 (the store critical-section
        # to_thread offload). Below 0.7.38 the ``scitex-todo mcp start`` server
        # wedges on the ~22s synchronous store write during its MCP init
        # handshake; with .mcp.json ``alwaysLoad: true`` doing a BLOCKING serial
        # load, that stalled init cascades and starves sibling tool-MCP servers'
        # registration too → ToolSearch finds zero tools ("dark tool-MCPs"
        # incident, 2026-07-06, root-caused on scitex-clew). Flooring here
        # upgrades past whatever scitex[all] pulls — same OVERRIDE pattern as
        # the providers, decoupled from the umbrella re-pin.
        uv pip install --python /opt/venv-sac/bin/python \
            "scitex-dev>=0.20.1" \
            "scitex-writer>=2.22.0" \
            "scitex-audio>=0.3.0" \
            "scitex-cv>=0.2.0" \
            "scitex-todo>=0.7.32"
    else
        /opt/venv-sac/bin/pip install --no-cache-dir --upgrade \
            pip setuptools wheel
        /opt/venv-sac/bin/pip install --no-cache-dir --upgrade \
            black flake8 \
            ipython ipdb \
            pytest pytest-cov \
            "claude-agent-sdk==0.2.110" \
            "scitex[all]" \
            xarray
        /opt/venv-sac/bin/pip install --no-cache-dir \
            --force-reinstall --no-deps \
            /opt/scitex-agent-container-src
        # scitex-dev keystone + the 3 leaf providers, pinned to PUBLISHED
        # PyPI floors (reproducible — NOT a moving git branch ref) — OVERRIDE
        # the older transitive pins scitex[all] pulls, so the federated
        # install in section 3 can discover every leaf's
        # ``scitex_dev.system_deps`` entry-point. Floors mirror the uv branch
        # above. Matches this branch's plain ``pip install`` style.
        # scitex-todo >=0.7.32 (TEMP: 0.7.38 unpublished — see uv-branch note;
        # aggregator moots #338). Historically floored for the store-wedge #338 — see the
        # uv branch above for the full rationale (MCP-init wedge → alwaysLoad
        # serial-load cascade → dark tool-MCPs). Same OVERRIDE pattern.
        /opt/venv-sac/bin/pip install --no-cache-dir \
            "scitex-dev>=0.20.1" \
            "scitex-writer>=2.22.0" \
            "scitex-audio>=0.3.0" \
            "scitex-cv>=0.2.0" \
            "scitex-todo>=0.7.32"
    fi

    # ---- 3. Federated system (apt) deps — SSoT install -----------------
    # The audio/video libs + the curated manuscript LaTeX toolchain
    # (texlive-* / biber / latexmk) that USED to be two hardcoded apt-get
    # blocks here are now DECLARED by the leaf packages and aggregated by
    # the scitex-dev keystone via the ``scitex_dev.system_deps``
    # entry-point group. Root-cause SSoT: each leaf owns its own apt deps
    # (scitex-audio = ffmpeg/portaudio; scitex-writer = the texlive set;
    # scitex-cv = none, opencv-python-headless bundles cv2's libs), so this
    # .def no longer duplicates them. Runs AFTER the venv install (section 2) so
    # every provider's entry-point is discoverable; apt needs root so this
    # is BUILD-time only (exactly where we are).
    #
    # FAIL-LOUD SUPERSET GUARD — a safety net for the cutover: assert the
    # federated set still covers EVERY package the old hardcoded blocks
    # installed, so a leaf accidentally dropping a declaration fails the
    # BUILD here rather than silently shipping a SIF missing pdflatex /
    # cv2's libs / ffmpeg (which would re-park paper + ripple-wm lanes).
    # The 17-name baseline is the audio + LaTeX set the two deleted apt blocks
    # carried; cv's old X-libs (libxcb1/libgl1/libglib2.0-0) are intentionally
    # ABSENT — scitex-cv went opencv-python-headless (cv2 libs bundled, zero
    # apt deps), so the federated set no longer carries them and the guard
    # must not demand them. Written to a temp file via heredoc (self-contained
    # — no committed baseline file to drift).
    cat > /tmp/sac-baseline-apt.txt <<'EOF'
ffmpeg
portaudio19-dev
texlive-latex-base
texlive-latex-recommended
texlive-latex-extra
texlive-pictures
texlive-plain-generic
texlive-lang-english
texlive-bibtex-extra
biber
texlive-fonts-recommended
texlive-fonts-extra
texlive-science
texlive-publishers
texlive-luatex
texlive-xetex
latexmk
EOF
    # Superset guard via the keystone's OWN verb (scitex-dev #256, shipped in
    # 0.20.1): ``check-superset`` reads the baseline file, compares it to the
    # aggregated federated set, and exits 0 GREEN / 1 RED (printing the
    # missing names) — keeping the guard's logic as SSoT on the keystone.
    # NB: the earlier ``comm``-based guard used bash PROCESS SUBSTITUTION
    # (a two-input process-sub diff), which apptainer %post (under /bin/sh =
    # dash) does NOT support → ``Syntax error: "(" unexpected`` (the build
    # FATAL this swap fixes). The verb is pure Python — no shell-isms.
    scitex-dev ecosystem system-deps check-superset \
        --baseline /tmp/sac-baseline-apt.txt \
        || { echo "FATAL: federated system-deps missing baseline pkgs (see above)" >&2; exit 1; }
    # Apply the federated set (apt-installs at build-time / root).
    scitex-dev ecosystem system-deps install --yes

    # ---- 4. Fail-loud verifies for the federated system deps -----------
    # A SIF that silently ships without these would re-park every paper
    # agent's compile lane and every ripple-wm compute lane exactly as the
    # pre-federation drift did. Verify the manuscript engine + driver, the
    # audio/video decoder, and that cv2 imports cleanly in the venv —
    # opencv-python-headless bundles its native libs, so a clean import is
    # the real proof the headless wheel works with zero apt X-libs.
    pdflatex --version
    latexmk --version
    ffmpeg -version
    /opt/venv-sac/bin/python -c 'import cv2; print(cv2.__version__)'

    # ---- 5. System-python invariant (paper-agent .venv base) -----------
    # Paper agents migrating onto this image keep a per-agent uv .venv whose
    # base interpreter resolves to the system python3 (3.12 on noble),
    # inherited unchanged from :base. Assert it survived this layer's
    # %post so a future edit here cannot silently break the interpreter the
    # paper venvs depend on (regression neurovista hit when a venv pointed
    # at a removed path). No new python is installed — this is a guard.
    /usr/bin/python3 --version

    # ---- 6. Bake the scitex-* version manifest (`sac versions`) --------
    # `sac versions --json` reads this baked manifest (source="manifest",
    # near-zero cost — a `cat`, not a full `pip list`) so scitex-dev's
    # ecosystem drift aggregator can see the base-image venv layer cheaply.
    # The verb falls back to a live `apptainer exec <sif> pip list` when
    # this file is absent (older images), so shipping it is purely additive.
    # This layer's scitex[all] + scitex-dev/-writer/-audio/-cv make the
    # manifest much richer than :base. Filtered to scitex-* and written in
    # pip's `--format=json` shape. Pure pipe + `python -c` (dash-safe — no
    # bash process substitution under /bin/sh).
    /opt/venv-sac/bin/pip list --format=json \
        | /opt/venv-sac/bin/python -c 'import json,sys; rows=[r for r in json.load(sys.stdin) if str(r.get("name","")).lower().replace("_","-").split("-")[0]=="scitex"]; json.dump(sorted(rows,key=lambda r:str(r.get("name","")).lower()), sys.stdout, indent=2)' \
        > /opt/scitex-versions.json
    cat /opt/scitex-versions.json

%environment
    export PATH=/opt/venv-sac/bin:$PATH
    export VIRTUAL_ENV=/opt/venv-sac

%runscript
    exec /opt/venv-sac/bin/python -m scitex_agent_container._runners.claude_session "$@"

%labels
    org.scitex.layer scitex
    org.scitex.runtime apptainer
    org.scitex.from scitex-agent-container:base
    org.scitex.contains "scitex[all] claude-agent-sdk scitex-agent-container ffmpeg portaudio black flake8 ipython pytest latex latexmk biber"

%help
    scitex-agent-container :scitex layer (sac default image).
    Layered on :base; adds scitex scientific stack, claude SDK, sac
    itself, and a curated manuscript LaTeX toolchain (pdflatex /
    lualatex / xelatex / latexmk / biber). System (apt) deps are now
    installed from the federated scitex_dev.system_deps providers
    (scitex-writer / -audio / -cv, aggregated by scitex-dev) — the SSoT,
    not a hardcoded apt list in this .def.
    Default entry point: python -m scitex_agent_container._runners.claude_session
