# scitex-agent-container:scitex — Apptainer recipe (canonical SSoT).
#
# Layered on apptainer-base. Default image used when an agent's
# spec.yaml leaves spec.image unset.
#
# Adds:
#   - python venv at /opt/venv-sac/ (avoids Ubuntu's PEP-668 fight)
#   - black, flake8, ipython, ipdb, pytest, pytest-cov
#   - claude-agent-sdk (the runner's API; bundles its own claude binary)
#   - scitex[all] (scientific stack)
#   - scitex-dev + scitex-writer/-audio/-cv (pinned PyPI; system-deps providers)
#   - the federated system (apt) deps declared by those leaves via the
#     ``scitex_dev.system_deps`` entry-point group (SSoT — NOT a hardcoded
#     apt list): ffmpeg/portaudio (audio) and the curated manuscript LaTeX
#     toolchain (latex/latexmk/biber). scitex-cv (opencv-python-headless)
#     declares zero apt deps.
#   - scitex-agent-container (sac CLI + runner module)
#
# Build:
#   # 1. base layer first
#   apptainer build base.sif containers/apptainer-base.def
#   # 2. then scitex on top, using base.sif as the bootstrap source
#   apptainer build scitex.sif containers/apptainer-scitex.def
#
# Or via scitex-container (preferred, with versioning):
#   scitex-container build scitex-agent-container-scitex

Bootstrap: localimage
From: ./sac-base.sif

%files
    # Bundle the package's OWN source tree on top of the base layer so
    # this layer's sac install is the source tree that shipped this
    # .def — see apptainer-base.def for the staging contract. Both
    # layers land the same tree at /opt/scitex-agent-container-src so a
    # version mismatch between base and scitex is structurally
    # impossible (both came from the same `sac image build` invocation).
    scitex-agent-container-src /opt/scitex-agent-container-src
    scitex-cards-src /opt/scitex-cards-src

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    # ---- 1. System (apt) deps now come from the federated SSoT ----------
    # The audio/video + LaTeX apt packages that USED to be hardcoded here
    # are now DECLARED by the leaf packages themselves via the
    # ``scitex_dev.system_deps`` entry-point group, aggregated by the
    # scitex-dev keystone and installed in section 3 below (after the venv
    # is built so the providers' entry-points are discoverable). Root-cause
    # SSoT: each leaf owns its own apt deps; no hardcoded apt list here.
    #   - ffmpeg / portaudio19-dev          → scitex-audio._system_deps
    #   - scitex-cv declares ZERO apt deps — opencv-python-headless bundles
    #       cv2's native libs in the wheel, so its provider returns [] (the
    #       old libxcb1/libgl1/libglib2.0-0 X-libs are no longer needed).
    #   - the curated texlive / biber / latexmk set → scitex-writer._system_deps
    # A FAIL-LOUD SUPERSET GUARD in section 3 verifies the federated set
    # still covers every package these blocks used to install, so this
    # cutover cannot silently drop a dependency.

    # ---- 2. Python venv + scitex stack ---------------------------------
    # Dedicated venv avoids Ubuntu 24.04 PEP-668 collisions with apt-installed
    # python3-wheel etc. PATH below puts /opt/venv-sac/bin first so all
    # python work hits this venv automatically.
    #
    # Resolver: uv (Rust, parallel) instead of pip. ``scitex[all]`` has a
    # huge transitive set (openalex-local, sphinx-rtd-theme, etc.) that
    # makes pip's backtracking thrash for 30+ min downloading metadata.
    # uv solves the same dependency set in 1-3 min by resolving in
    # parallel.  Falls back to pip if uv is missing on the base layer.
    python3 -m venv /opt/venv-sac
    # Ensure uv is reachable: the apptainer-base layer installs it to
    # /root/.local/bin (uv installer ignores UV_INSTALL_DIR for the
    # curl|sh path and uses XDG_BIN_HOME → ~/.local/bin under root).
    # apptainer's %post starts with a minimal PATH so we extend it.
    export PATH="/root/.local/bin:/usr/local/bin:$PATH"
    # sac is installed from /opt/scitex-agent-container-src/ — the
    # package's OWN source tree, copied in by the %files section above.
    # The SIF's sac version is structurally pinned to the source tree
    # that shipped this .def; no `git+...@main` snapshot drift.
    # claude-agent-sdk is FLOORED TO LATEST here too (installed bare, no
    # `==` pin) — matching the base layer, per the operator directive to
    # "carry the LATEST of ALL ecosystem packages". Lockstep is preserved
    # because BOTH layers now float the SDK to latest (nothing to drift
    # apart), and the runtime `claude` CLI is the decoupled standalone
    # npm `@anthropic-ai/claude-code@latest` from apptainer-base.def §6b,
    # not the SDK's bundled binary.
    #
    # ``xarray`` is listed EXPLICITLY here because ``scitex[all]``'s
    # current extras set does not pull it. Without xarray, clew's
    # ``scitex.io`` preflight on Spartan fails its import probe and
    # silently falls back to "minimal mode" — runs look green but
    # lose the labelled-array surface the cohort-A capsules need.
    # Pinned explicit so a future ``scitex[all]`` re-bake cannot
    # silently drop the dep without surfacing as a build-time
    # uv/pip failure. (Caught by clew's capsule-0220918 audit,
    # 2026-06-06; symmetric with the apt-side libglib2.0-0 add in
    # apptainer-base.def — both close silent-fallback paths.)
    # Resolve the scientific umbrella, staged SAC and staged Cards in ONE
    # transaction. Installing the umbrella first and replacing its exact leaf
    # pins afterward produced an image that built successfully but failed
    # pip check. A conflicting published umbrella must fail resolution instead.
    # The 2.30.9 cohort is a publication prerequisite for this layer; the CLI
    # and base image can be released independently while it is unavailable.

    # ---- %files NESTING GUARD (INCIDENT 2026-07-18) ---------------------
    # apptainer %files copies INTO an existing destination directory (plain
    # ``cp dir existing_dir/`` semantics). A BASE image that already baked
    # /opt/scitex-agent-container-src therefore makes THIS layer's copy land
    # NESTED at /opt/scitex-agent-container-src/scitex-agent-container-src/,
    # leaving the OUTER (stale, base-era) tree as the one uv actually builds.
    # Three consecutive scitex-only bakes shipped pre-#742 sac exactly this
    # way while reporting rc=0: the staged source was correct and simply one
    # level too deep. Flatten deterministically — promote the nested tree.
    if [ -d /opt/scitex-agent-container-src/scitex-agent-container-src ]; then
        echo "INFO: %files nested the staged source (destination pre-existed); flattening."
        rm -rf /opt/.sac-src-fresh
        mv /opt/scitex-agent-container-src/scitex-agent-container-src /opt/.sac-src-fresh
        rm -rf /opt/scitex-agent-container-src
        mv /opt/.sac-src-fresh /opt/scitex-agent-container-src
    fi
    # FAIL LOUD — never build from a shape we do not understand.
    if [ -d /opt/scitex-agent-container-src/scitex-agent-container-src ]; then
        echo "FATAL: staged source still nested after flatten — refusing to build." >&2
        exit 1
    fi
    if [ ! -f /opt/scitex-agent-container-src/pyproject.toml ]; then
        echo "FATAL: staged source has no pyproject.toml — wrong tree staged." >&2
        exit 1
    fi
    # Cards is also present in :base, so the same Apptainer directory-copy
    # semantics can nest this layer's fresh tree below the inherited one.
    if [ -d /opt/scitex-cards-src/scitex-cards-src ]; then
        echo "INFO: %files nested the staged Cards source; flattening."
        rm -rf /opt/.cards-src-fresh
        mv /opt/scitex-cards-src/scitex-cards-src /opt/.cards-src-fresh
        rm -rf /opt/scitex-cards-src
        mv /opt/.cards-src-fresh /opt/scitex-cards-src
    fi
    if [ -d /opt/scitex-cards-src/scitex-cards-src ] \
        || [ ! -f /opt/scitex-cards-src/pyproject.toml ]; then
        echo "FATAL: staged Cards source has an unexpected shape." >&2
        exit 1
    fi

    # Rebuild both local source distributions even when their versions equal
    # cached wheels. Keep normal dependency resolution enabled: source extras,
    # provider floors and the umbrella's exact pins must agree together.
    if command -v uv >/dev/null; then
        uv pip install --no-cache --python /opt/venv-sac/bin/python -U \
            --reinstall-package scitex-agent-container \
            --reinstall-package scitex-cards \
            "/opt/scitex-agent-container-src[all,dev]" \
            "/opt/scitex-cards-src[mcp,postgres]" \
            "scitex[all]>=2.30.9" \
            black flake8 ipython ipdb \
            "pytest>=7.0.0,<9.0.0" pytest-cov \
            "build>=1.0" "hatchling>=1.20" \
            claude-agent-sdk "openai-agents>=0.19.0" xarray \
            "scitex-dev>=0.56.8" "scitex-writer>=2.29.0" \
            "scitex-audio>=0.3.0" "scitex-cv>=0.2.0" \
            "scitex-storage>=0.3.0"
    else
        /opt/venv-sac/bin/pip install --no-cache-dir --upgrade \
            pip setuptools wheel
        /opt/venv-sac/bin/pip install --no-cache-dir --upgrade --force-reinstall \
            "/opt/scitex-agent-container-src[all,dev]" \
            "/opt/scitex-cards-src[mcp,postgres]" \
            "scitex[all]>=2.30.9" \
            black flake8 ipython ipdb \
            "pytest>=7.0.0,<9.0.0" pytest-cov \
            "build>=1.0" "hatchling>=1.20" \
            claude-agent-sdk "openai-agents>=0.19.0" xarray \
            "scitex-dev>=0.56.8" "scitex-writer>=2.29.0" \
            "scitex-audio>=0.3.0" "scitex-cv>=0.2.0" \
            "scitex-storage>=0.3.0"
    fi
    # A successful installer is insufficient evidence of a coherent inherited
    # environment. Refuse the image before symbol checks or system provisioning
    # if any installed distribution has unsatisfied requirements.
    /opt/venv-sac/bin/python -m pip check

    # ---- 2b. FAIL-LOUD staleness gate — assert BY SYMBOL ----------------
    # The counterpart of the :base layer's section-6c gate, re-run HERE
    # because this layer inherits base's venv and then mutates it: the
    # whole scientific resolve above can move scitex-todo. Base passing proves
    # nothing about what THIS image ships. Guard the artefact you ship.
    #
    # Asserts BY SYMBOL, never by version string — a duplicate/orphaned
    # .dist-info freezes what importlib.metadata reports while the live
    # code differs (open incident), so "the SIF says 0.9.4" is not
    # evidence. ``scitex_todo._throughput.WIP_STATUSES`` (scitex-todo #356,
    # first released in 0.8.0) is the WIP gate's status set: it must
    # contain ``in_progress`` and no terminal state. A stale bake dies on
    # the import; a regressed one dies on the membership checks.
    #
    # SECOND probe, and in THIS layer it is the sharp one: section 2's
    # step 2 force-reinstalls sac from the %files-staged source tree
    # precisely because step 1's ``scitex[all]`` drags in a transitive
    # ``scitex-agent-container`` wheel from PyPI, and uv once SKIPPED the
    # local install under its version-already-satisfied check — the SIF
    # quietly shipped the WRONG sac tree. The two-pass install is the fix;
    # this probe is the proof it worked, which nothing has ever asserted.
    #
    # Explicit ``sys.exit(1)``, not ``assert`` — a bare assert is stripped
    # under ``python -O`` / PYTHONOPTIMIZE, which would silently disarm the
    # very gate that exists to end silent staleness.
    cat > /tmp/sac-assert-image-fresh.py <<'EOF'
"""Build-time gate: nothing stale got baked into this image.

Asserts BY SYMBOL, never by version string. The version string LIES — in
two different ways, and BOTH of them live in this image:

  * an orphaned / duplicate .dist-info freezes what importlib.metadata
    reports while the code actually on sys.path is a different tree;
  * the %files-staged sac reports its last RELEASED version no matter how
    new the bundled source tree really is.

A symbol cannot lie: it is imported from the code this image will run.
Exits non-zero and prints WHY on failure; the .def turns that into a
fatal build error.
"""

import importlib.metadata as md
import sys

# Clean starts require this exact psutil capability for inbox sidecar
# reconciliation and Hermes stale-session recovery.  An unhandled ImportError
# rejects the image before publication.
from psutil import process_iter as _psutil_process_iter  # noqa: F401

# Both imports ARE staleness probes: each raises ImportError (unhandled →
# non-zero exit → dead build) on a stale bake, naming the missing symbol.

# scitex-todo #356 (first released in 0.8.0): the WIP gate must count
# `in_progress` ONLY. Below it, every agent's WIP gate counts DEFERRED +
# CANCELLED cards as open and refuses legitimate card creation — the
# 2026-07-12 fleet-drift incident this gate exists to end.
#
# Package renamed scitex-cards (2026-07-16): the canonical module is
# scitex_cards. The wheel USED to ship a scitex_todo shim and this gate
# asserted the two aliased; that shim was DELETED 2026-08-16, so there is
# no second module tree left to disagree with and the import below is the
# whole check.
# noqa placement is deliberate: this import LOOKS unused and is not. The
# probe is an artifact gate that asserts BY SYMBOL that the SIF shipped a
# whole scitex_cards, so the bare import IS the assertion — ruff F401 reads
# it as dead because nothing references the name, and removing it on that
# advice blinded the gate and reddened test_probe_imports_scitex_cards.
import scitex_cards  # noqa: F401  (the import itself is the check)
from scitex_cards._messaging import canonical_agent_identity
from scitex_cards._notification_watch import _doorbell_status  # noqa: F401
from scitex_cards._throughput import WIP_STATUSES

# scitex-cards 0.49.1: the comment-preserving mirror write, CORRECTED.
# Through 0.48.0, comment_task / update_task rebuilt a card from the doc the
# caller happened to hold and DROPPED every comment row that doc had not
# seen — a peer's comment written between your read and your write was
# destroyed silently, with a success report. 0.49.0 added this symbol to fix
# that and indexed its rows POSITIONALLY (row[0]), which is KeyError(0) on
# psycopg's dict_row, so on PostgreSQL every card holding comments became
# READ-ONLY: uncommentable, unupdatable, uncompletable, undeletable. 0.49.1
# reads row["author"]. THE FLOOR IS >=0.49.1 AND MUST NEVER BE >=0.49.0.
#
# THIS IMPORT PROVES PRESENCE, NOT BEHAVIOUR, and that distinction is the
# whole lesson of 2026-08-23: it passed on the broken 0.49.0, because the
# function was there and wrong. Measured that day, five independent gates
# went green on that artifact within one hour — this probe, the master-side
# SYMBOL_PROBE, the Spartan bake's content check, upstream's hasattr check,
# and a 7537-test suite on a store where the defect cannot exist.
# So the FLOOR is what excludes the broken release; this import only catches
# a version string that lies; and only a post-deploy write to a card that
# ALREADY HAS a comment proves the path actually runs.
from scitex_cards._mirror_rows import _merge_unseen_comment_rows  # noqa: F401

# scitex-dev 0.56.6: the bounded (origin, seq) oplog-allocation retry.
# Through 0.56.5, Store._append read MAX(seq) ONCE and then inserted, so a
# burst of writers on a SINGLE node collided on the oplog (origin, seq)
# primary key with no bounded retry -- 7/8 and 5/8 failures on the two
# concurrency tests, reproduced three times. 0.56.6 adds this constant and
# the retry loop that uses it, plus an advisory lock around table creation.
#
# THIS IMPORT PROVES PRESENCE, NOT BEHAVIOUR -- the same narrow job as the
# scitex-cards import above, and the same 2026-08-23 lesson. The FLOOR is
# what excludes the releases without the retry; this import only catches a
# version string that lies; and only a concurrent multi-writer append after
# deploy proves the loop actually settles under contention.
#
# The name is PRIVATE -- underscore-prefixed and absent from __all__ -- so
# upstream may rename or inline it with no deprecation, and that would land
# here as a dead bake far from scitex-dev's repo. If this line is what broke
# the build, read scitex_dev/store/_store.py before suspecting the image.
from scitex_dev.store._store import _SEQ_ALLOCATION_ATTEMPTS  # noqa: F401



# sac #633: auto-provisions a new agent's container overlay root; without
# it every newly-created agent is stillborn on a raw apptainer FATAL.
# This symbol is NEWER THAN ANY PUBLISHED sac RELEASE, so it doubles as
# proof that the %files-staged local source tree won the install and no
# transitive PyPI sac wheel overwrote it. Raise this floor when a newer
# must-ship fix lands; never delete the probe.
from scitex_agent_container.runtimes._apptainer_overlay import ensure_overlay_dirs

# Printed for the BUILD LOG only — these numbers are NOT the gate.
print("scitex-cards reported version:", md.version("scitex-cards"))
print("scitex-cards WIP_STATUSES    :", sorted(WIP_STATUSES))
print("sac reported version         :", md.version("scitex-agent-container"))
print(
    "sac overlay auto-provision   :",
    f"{ensure_overlay_dirs.__module__}.{ensure_overlay_dirs.__name__}",
)

failures = []

# The version string lies (uv's wheel cache is version-keyed and sac's
# version does not advance per-commit). File content cannot lie — but the
# comparison must be SET-AWARE: compare CONTENT of .py files present in
# BOTH the installed package and the staged source (shared relative
# paths); a stale wheel makes a shared file's content differ.
# Set-differences (wheel excludes data files) are NOT staleness and are
# ignored — comparing whole-tree hashes false-positives on them. Generic
# on purpose: it names no feature, so a rename or decoupling never breaks it.
import hashlib as _hashlib, pathlib as _pathlib, sysconfig as _sysconfig
# Resolve the INSTALLED tree from this interpreter's OWN site-packages, never
# via ``scitex_agent_container.__file__`` (INCIDENT 2026-07-18): during %post
# the staged source can be importable, in which case __file__ points at the
# STAGED tree, the gate compares that tree to ITSELF, and it passes no matter
# how stale the real install is. It false-greened a pre-#742 image exactly so.
_installed_root = _pathlib.Path(_sysconfig.get_paths()["purelib"]) / "scitex_agent_container"
_staged_root = _pathlib.Path("/opt/scitex-agent-container-src/src/scitex_agent_container")
# A gate that cannot distinguish its two operands is blind — say so, loudly.
if not _installed_root.is_dir():
    failures.append(
        "content assert cannot find the INSTALLED sac at %s — sac is not "
        "installed into site-packages; the gate has nothing to verify." % _installed_root
    )
elif _installed_root.resolve() == _staged_root.resolve():
    failures.append(
        "content assert operands are the SAME directory (%s) — installed and "
        "staged resolve identically, so the comparison proves nothing." % _installed_root
    )
def _rel_shas(root):
    out = {}
    for p in root.rglob("*.py"):
        rel = p.relative_to(root).as_posix()
        out[rel] = _hashlib.sha256(p.read_bytes()).hexdigest()
    return out
if _staged_root.is_dir():
    _inst = _rel_shas(_installed_root)
    _stg = _rel_shas(_staged_root)
    _shared = sorted(set(_inst) & set(_stg))
    print("content-assert shared .py files:", len(_shared))
    if len(_shared) < 50:
        failures.append(
            "content assert compared only %d shared .py files (expected hundreds) — "
            "installed/staged package roots may be misaligned; comparison is not meaningful." % len(_shared)
        )
    else:
        _mismatch = [rel for rel in _shared if _inst[rel] != _stg[rel]]
        if _mismatch:
            failures.append(
                "installed sac differs from staged source in %d of %d shared .py files "
                "(e.g. %s) — a STALE wheel shipped; the fix did NOT ship. Verify --no-cache-dir "
                "on the sac install." % (len(_mismatch), len(_shared), _mismatch[:5])
            )
else:
    print("NOTE: staged source not at /opt/scitex-agent-container-src; content assert skipped")

# The WIP gate counts work IN FLIGHT, and only that. Terminal/parked
# states must never occupy a WIP slot.
if "in_progress" not in WIP_STATUSES:
    failures.append(f"'in_progress' missing from WIP_STATUSES: {sorted(WIP_STATUSES)}")
if canonical_agent_identity("agent:scitex-hub") != "scitex-hub":
    failures.append("scitex-cards #1003 DM recipient canonicalization is absent")
terminal = {"deferred", "cancelled", "done"} & set(WIP_STATUSES)
if terminal:
    failures.append(
        f"terminal states {sorted(terminal)} counted as WIP: {sorted(WIP_STATUSES)} "
        "— the pre-0.8.0 bug that jams every agent's WIP gate."
    )

# Exactly one installed distribution may claim each name. Two (an
# orphaned .dist-info left by a partial reinstall) is the failure mode
# that lets the reported version diverge from the code.
for name in ("scitex-cards", "scitex-agent-container"):
    dists = [
        dist
        for dist in md.distributions()
        if (dist.metadata["Name"] or "").lower().replace("_", "-") == name
    ]
    if len(dists) != 1:
        failures.append(
            f"{len(dists)} {name} distributions installed (expected 1) — a "
            "duplicate/orphaned .dist-info makes the reported version a lie."
        )

if failures:
    print("", file=sys.stderr)
    for line in failures:
        print(f"  - {line}", file=sys.stderr)
    sys.exit(1)

print("OK: scitex-cards WIP-gate + sac overlay + staged-source content present and correct.")
EOF
    test "$(cat /opt/scitex-cards-src/SAC_UPSTREAM_COMMIT)" = "1a3815aac3b4162cf3adea29344deea280d3aab8"
    /opt/venv-sac/bin/python /tmp/sac-assert-image-fresh.py \
        || { echo "FATAL: stale or wrong-tree package baked into this image (see above). Raise the floor / fix the staging; do NOT weaken this gate." >&2; exit 1; }

    # ---- 3. Federated system (apt) deps — SSoT install -----------------
    # The audio/video libs + the curated manuscript LaTeX toolchain
    # (texlive-* / biber / latexmk) that USED to be two hardcoded apt-get
    # blocks here are now DECLARED by the leaf packages and aggregated by
    # the scitex-dev keystone via the ``scitex_dev.system_deps``
    # entry-point group. Root-cause SSoT: each leaf owns its own apt deps
    # (scitex-audio = ffmpeg/portaudio; scitex-writer = the texlive set;
    # scitex-cv = none, opencv-python-headless bundles cv2's libs), so this
    # .def no longer duplicates them. Runs AFTER the venv install (section 2) so
    # every provider's entry-point is discoverable; apt needs root so this
    # is BUILD-time only (exactly where we are).
    #
    # FAIL-LOUD SUPERSET GUARD — a safety net for the cutover: assert the
    # federated set still covers EVERY package the old hardcoded blocks
    # installed, so a leaf accidentally dropping a declaration fails the
    # BUILD here rather than silently shipping a SIF missing pdflatex /
    # cv2's libs / ffmpeg (which would re-park paper + ripple-wm lanes).
    # The 17-name baseline is the audio + LaTeX set the two deleted apt blocks
    # carried; cv's old X-libs (libxcb1/libgl1/libglib2.0-0) are intentionally
    # ABSENT — scitex-cv went opencv-python-headless (cv2 libs bundled, zero
    # apt deps), so the federated set no longer carries them and the guard
    # must not demand them. Written to a temp file via heredoc (self-contained
    # — no committed baseline file to drift).
    cat > /tmp/sac-baseline-apt.txt <<'EOF'
ffmpeg
portaudio19-dev
texlive-latex-base
texlive-latex-recommended
texlive-latex-extra
texlive-pictures
texlive-plain-generic
texlive-lang-english
texlive-bibtex-extra
biber
texlive-fonts-recommended
texlive-fonts-extra
texlive-science
texlive-publishers
texlive-luatex
texlive-xetex
latexmk
EOF
    # Superset guard via the keystone's OWN verb (scitex-dev #256, shipped in
    # 0.20.1): ``check-superset`` reads the baseline file, compares it to the
    # aggregated federated set, and exits 0 GREEN / 1 RED (printing the
    # missing names) — keeping the guard's logic as SSoT on the keystone.
    # NB: the earlier ``comm``-based guard used bash PROCESS SUBSTITUTION
    # (a two-input process-sub diff), which apptainer %post (under /bin/sh =
    # dash) does NOT support → ``Syntax error: "(" unexpected`` (the build
    # FATAL this swap fixes). The verb is pure Python — no shell-isms.
    scitex-dev ecosystem system-deps check-superset \
        --baseline /tmp/sac-baseline-apt.txt \
        || { echo "FATAL: federated system-deps missing baseline pkgs (see above)" >&2; exit 1; }
    # Apply the federated set (apt-installs at build-time / root).
    scitex-dev ecosystem system-deps install --yes

    # ---- 4. Fail-loud verifies for the federated system deps -----------
    # A SIF that silently ships without these would re-park every paper
    # agent's compile lane and every ripple-wm compute lane exactly as the
    # pre-federation drift did. Verify the manuscript engine + driver, the
    # audio/video decoder, and that cv2 imports cleanly in the venv —
    # opencv-python-headless bundles its native libs, so a clean import is
    # the real proof the headless wheel works with zero apt X-libs.
    pdflatex --version
    latexmk --version
    ffmpeg -version
    /opt/venv-sac/bin/python -c 'import cv2; print(cv2.__version__)'

    # ---- 5. System-python invariant (paper-agent .venv base) -----------
    # Paper agents migrating onto this image keep a per-agent uv .venv whose
    # base interpreter resolves to the system python3 (3.12 on noble),
    # inherited unchanged from :base. Assert it survived this layer's
    # %post so a future edit here cannot silently break the interpreter the
    # paper venvs depend on (regression neurovista hit when a venv pointed
    # at a removed path). No new python is installed — this is a guard.
    /usr/bin/python3 --version

    # ---- 6. Bake the scitex-* version manifest (`sac versions`) --------
    # `sac versions --json` reads this baked manifest (source="manifest",
    # near-zero cost — a `cat`, not a full `pip list`) so scitex-dev's
    # ecosystem drift aggregator can see the base-image venv layer cheaply.
    # The verb falls back to a live `apptainer exec <sif> pip list` when
    # this file is absent (older images), so shipping it is purely additive.
    # This layer's scitex[all] + scitex-dev/-writer/-audio/-cv make the
    # manifest much richer than :base. Filtered to scitex-* and written in
    # pip's `--format=json` shape. Pure pipe + `python -c` (dash-safe — no
    # bash process substitution under /bin/sh).
    /opt/venv-sac/bin/pip list --format=json \
        | /opt/venv-sac/bin/python -c 'import json,sys; rows=[r for r in json.load(sys.stdin) if str(r.get("name","")).lower().replace("_","-").split("-")[0]=="scitex"]; json.dump(sorted(rows,key=lambda r:str(r.get("name","")).lower()), sys.stdout, indent=2)' \
        > /opt/scitex-versions.json
    cat /opt/scitex-versions.json

%environment
    export PATH=/opt/venv-sac/bin:$PATH
    export VIRTUAL_ENV=/opt/venv-sac

%runscript
    exec /opt/venv-sac/bin/python -m scitex_agent_container._runners.claude_session "$@"

%labels
    org.scitex.layer scitex
    org.scitex.runtime apptainer
    org.scitex.from scitex-agent-container:base
    org.scitex.cards.commit 1a3815aac3b4162cf3adea29344deea280d3aab8
    org.scitex.contains "scitex[all] claude-agent-sdk scitex-agent-container ffmpeg portaudio black flake8 ipython pytest build hatchling latex latexmk biber"

%help
    scitex-agent-container :scitex layer (sac default image).
    Layered on :base; adds scitex scientific stack, claude SDK, sac
    itself, and a curated manuscript LaTeX toolchain (pdflatex /
    lualatex / xelatex / latexmk / biber). System (apt) deps are now
    installed from the federated scitex_dev.system_deps providers
    (scitex-writer / -audio / -cv, aggregated by scitex-dev) — the SSoT,
    not a hardcoded apt list in this .def.
    Default entry point: python -m scitex_agent_container._runners.claude_session
