[Unit]
Description=Refresh sac account OAuth access-tokens every ~4 hours
Documentation=https://github.com/ywatanabe1989/scitex-agent-container

[Timer]
# Run shortly after boot/login so a long-stopped host catches up
# without waiting a full interval. Anthropic access-tokens are
# typically ~1h-lived; 4h is well below the refresh_token lifetime
# and well above the access-token TTL, so we always have a fresh one
# on hand without hammering the token endpoint.
OnBootSec=15min
OnUnitActiveSec=4h
# If the host was off across a scheduled run, catch up on next boot.
Persistent=true
Unit=sac-accounts-refresh.service

[Install]
WantedBy=timers.target
